# ============================================================
# Market Intelligence Dashboard — Environment Variables
# ============================================================
# Copy to .env.local and fill in values. Do not commit .env.local.
#
# Variables the app reads today: FRED_API_KEY, ANTHROPIC_API_KEY,
# YAHOO_FINANCE_ENABLED. Others below are reserved for future wiring.
# ============================================================

# ---- FRED API (Federal Reserve Economic Data) — USED BY APP ----
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Account: https://fredaccount.stlouisfed.org/login/secure/
# Powers: Fed policy, Treasury yields, liquidity, macro series modules
FRED_API_KEY=

# ---- Anthropic (Claude) — USED BY APP (optional) ----
# https://console.anthropic.com → API Keys
# Powers: /api/ai/summary and /api/ai/explain
ANTHROPIC_API_KEY=

# ---- Yahoo Finance — USED BY APP (no key) ----
# Set to false to disable market prices, breadth, flows, watchlist
YAHOO_FINANCE_ENABLED=true

# ---- BLS API — NOT READ BY CODE YET (reserved) ----
# Free registration: https://data.bls.gov/registrationEngine/
# Macro/labor data currently comes from FRED only
BLS_API_KEY=

# ---- Polygon.io — NOT READ BY CODE YET (reserved) ----
# https://polygon.io — for future options / premium market data
POLYGON_API_KEY=

# ---- App label — NOT READ BY CODE YET (optional for your own use) ----
NEXT_PUBLIC_APP_ENV=development
