# ============================================================
# Market Intelligence Dashboard — Environment Variables
# ============================================================
# Dev port: use `npm run dev` (default 3001) or `PORT=3001 npx next dev`.
# Next.js reads PORT from the shell when the CLI starts; .env.local alone
# does not change the dev server port.
# ============================================================
# Copy to .env.local and fill in values. Do not commit .env.local.
#
# Variables the app reads today: FRED_API_KEY, ANTHROPIC_API_KEY,
# YAHOO_FINANCE_ENABLED, OPTIONS_CHAIN_SOURCE (optional), POLYGON_API_KEY (optional).
# BLS reserved below.
# ============================================================

# ---- FRED API (Federal Reserve Economic Data) — USED BY APP ----
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Account: https://fredaccount.stlouisfed.org/login/secure/
# Powers: Fed policy, Treasury yields, liquidity, macro series modules
FRED_API_KEY=
# Optional: reduce St. Louis Fed 502s — series per batch per module (default 6), ms between batches (40)
# FRED_MAX_CONCURRENT=5
# FRED_BATCH_GAP_MS=60
# Retries on 502/503/504/429 (default 3 attempts, 400ms base backoff)
# FRED_FETCH_ATTEMPTS=3
# FRED_RETRY_BASE_MS=400

# ---- Anthropic (Claude) — USED BY APP (optional) ----
# https://console.anthropic.com → API Keys
# Powers: /api/ai/summary and /api/ai/explain
ANTHROPIC_API_KEY=

# ---- Yahoo Finance — USED BY APP (no key) ----
# Set to false to disable market prices, breadth, flows, watchlist
YAHOO_FINANCE_ENABLED=true
# Verbose server logs for /api/dashboard/options + Yahoo chain (default: on). Set false to silence.
# DASHBOARD_OPTIONS_LOG=false
# Throttle chart API (quotes + sparklines) — default 10 concurrent, 50ms between batches (raise gaps if 429)
# YAHOO_MAX_CONCURRENT=6
# YAHOO_CHART_GAP_MS=120
# Hard cap on v8 chart HTTP calls per minute (0 = unlimited). When exceeded, serve cache / stale fallback.
# YAHOO_CHART_MAX_PER_MINUTE=180
# Circuit breaker: trip Yahoo **chart** family after N 429s within window (ms), cooldown (ms)
# YAHOO_CHART_CB_429_THRESHOLD=3
# YAHOO_CHART_CB_429_WINDOW_MS=60000
# YAHOO_CHART_CB_COOLDOWN_MS=600000
# Circuit breaker for Yahoo **options** v7 (separate from chart)
# YAHOO_OPTIONS_CB_429_THRESHOLD=2
# YAHOO_OPTIONS_CB_429_WINDOW_MS=45000
# YAHOO_OPTIONS_CB_COOLDOWN_MS=900000

# Client: defer /api/dashboard/options after core (ms) so quote batch finishes first
# NEXT_PUBLIC_OPTIONS_LANE_DEFER_MS=800
# Client: reuse last successful JSON for this many ms so React Strict Mode remount does not refetch (500–120000, default 5000)
# NEXT_PUBLIC_CLIENT_FETCH_DEDUP_MS=5000

# Optional: override Yahoo options underlying (default **^SPX** = SPX index options).
# Do **not** use ^GSPC here — that is the spot index; Yahoo returns quote-only (no option chain).
# Examples: ^SPX (default if unset), SPY for ETF chain experiments
# YAHOO_OPTIONS_SYMBOL=SPY
# Yahoo options: optional pause after chart batch (default 0). Set 2500–4000 if options hit 429.
# YAHOO_OPTIONS_AFTER_MARKET_MS=3000
# Max expiration pages merged (default 1). More = more 429 risk.
# YAHOO_OPTIONS_MAX_EXPIRATIONS=1
# YAHOO_OPTIONS_REQUEST_GAP_MS=200
# Yahoo quotes + options use `yahoo-finance2` (crumb/cookies). Host is chosen by the library, not env.
# (Legacy) YAHOO_OPTIONS_HOST is no longer read.

# ---- BLS API — NOT READ BY CODE YET (reserved) ----
# Free registration: https://data.bls.gov/registrationEngine/
# Macro/labor data currently comes from FRED only
BLS_API_KEY=

# ---- SPX options chain source (optional) ----
# Default when unset: yahoo (^SPX via unofficial Yahoo API). Aliases: yfinance, yfin
# auto = try Polygon if POLYGON_API_KEY set, else Yahoo; on Polygon error fall back to Yahoo
# polygon = Polygon I:SPX only (no Yahoo fallback)
# OPTIONS_CHAIN_SOURCE=yfinance

# ---- Polygon.io — OPTIONAL: I:SPX snapshot when source is polygon or auto+key ----
# https://polygon.io
POLYGON_API_KEY=

# ---- App label — NOT READ BY CODE YET (optional for your own use) ----
NEXT_PUBLIC_APP_ENV=development
